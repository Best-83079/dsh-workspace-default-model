{
  "name": "dsh-workspace-default-model",
  "version": "2.1.0",
  "private": true,
  "description": "Per-workspace and deployment default models for new DeepSeek Harness sessions, editable from one Settings page.",
  "type": "module",
  "license": "MIT",
  "author": "Best-83079",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "default-model",
    "workspace",
    "settings"
  ],
  "homepage": "https://github.com/Best-83079/dsh-workspace-default-model#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Best-83079/dsh-workspace-default-model.git"
  },
  "bugs": {
    "url": "https://github.com/Best-83079/dsh-workspace-default-model/issues"
  },
  "scripts": {
    "test": "node test/match.mjs && node test/host-probe.mjs && node test/client-global-probe.mjs",
    "probe:resolve": "node test/resolve-probe.mjs",
    "probe:config": "node test/config-probe.mjs",
    "probe:client": "node test/client-global-probe.mjs",
    "probe:sessions": "node test/session-route-probe.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "match.js",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
